{
  "$schema": "https://app.kilo.ai/config.json",
  "skills": {
    "paths": [
      "./.kilo/skills"
    ]
  },
  "mcp": {
    "vue-docs": {
      "type": "remote",
      "url": "https://mcp.vue-mcp.org/mcp",
      "enabled": true
    },
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    },
    "mcpServers": {
      "vue-skills": { 
        "command": "npx", 
        "args": ["-y", "@pymodel/vue-skills-mcp"] 
      }
    }
  }
}
