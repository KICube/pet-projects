{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "vue-docs": {
      "type": "remote",
      "url": "https://mcp.vue-mcp.org/mcp",
      "enabled": true
    },
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true
    },
    "css": {
      "type": "local",
      "command": ["npx", "-y", "css-mcp"],
      "enabled": true,
      "timeout": 15000
    },
    "js-mcp": {
      "type": "local",
      "command": ["npx", "-y", "js-mcp"],
      "enabled": true,
      "timeout": 15000
    },
    "npm-tools": {
      "type": "local",
      "command": ["npx", "-y", "@rog0x/mcp-npm-tools"],
      "enabled": true,
      "timeout": 15000
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "W:\\a\\a"],
      "enabled": true,
      "timeout": 15000
    },
    "screenshot": {
      "type": "local",
      "command": ["node", "C:\\Users\\bogda\\.config\\kilo\\mcp-screenshot-server\\build\\index.js"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
